# Copia este archivo como ".env.local" (en local) o configura la misma
# variable en Vercel → Project Settings → Environment Variables.
#
# URL del nodo "Webhook" de tu flujo de n8n. /api/contact la lee en el
# servidor y le reenvía cada solicitud del formulario de contacto (un
# envío directo desde el navegador no funciona: los webhooks de n8n no
# devuelven cabeceras CORS). Mientras esté vacía, las solicitudes solo se
# registran en el log del servidor.
N8N_CONTACT_WEBHOOK_URL=
